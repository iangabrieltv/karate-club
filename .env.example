# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# FIREBASE WEB CONFIGURATION (Karate Club - gen-lang-client-0540643703)
# ==============================================================================
# Obtenha estes valores no Console do Firebase em:
# Configurações do Projeto > Geral > Seus aplicativos > Karate Club Web (Config)
# Preencha em seu arquivo .env local sem comitar valores privados:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0540643703.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0540643703"
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# ==============================================================================
# BACKEND SERVER CONFIGURATION (Exclusivo do Servidor Node.js - NUNCA expor com VITE_)
# ==============================================================================
# Segredo único de inicialização para o endpoint POST /api/setup/bootstrap:
SERVER_BOOTSTRAP_SECRET=""

# Credencial de serviço do Firebase Admin SDK (Opcional se ADC estiver disponível):
# Em ambientes sem ADC (ex: VPS padrão), forneça a string JSON da chave de conta de serviço:
FIREBASE_SERVICE_ACCOUNT_KEY=""

